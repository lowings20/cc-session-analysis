      "magic_moments": [
        {
          "id": "nick-apr29-risk-reward",
          "facilitator": "Nick White",
          "session_label": "BD EMEA LEAPI Cohort 1 · April 29, 2026",
          "timestamp": "00:47:07",
          "transcript_path": "MP/MP-04.29.26-Nick/GMT20260429-065916_Recording.transcript (1).vtt",
          "context": "Debriefing a team that took a bold position with senior leaders",
          "quote": "Without risk, we don't get rewards. There's nothing wrong with talking about risk, there's nothing wrong with presenting risk, even having high risk — if we can articulate the upside.",
          "why_magic": "Nick reframes risk from a thing to hide from leadership into a thing to *present* to leadership. For managers heading into real budget conversations, that's the unlock — it's not the risk that kills the proposal, it's the failure to articulate the upside.",
          "case_challenge": "Managing Profitability"
        },
        {
          "id": "nick-apr30-already-know",
          "facilitator": "Nick White",
          "session_label": "BD EMEA LEAPI Cohort 2 · April 30, 2026",
          "timestamp": "00:01:11",
          "transcript_path": "MP/MP-04.30.26-Nick/GMT20260430-080027_Recording.transcript (1).vtt",
          "context": "Opening minute with a finance-fluent cohort",
          "quote": "When you go on a training and it's stuff you already know, you think, you know, what on earth am I doing here? But actually, by turning it around, that can be really quite powerful for you.",
          "why_magic": "He pre-empts the disengagement risk in a room full of finance people who could teach this content themselves. The frame: your job is to teach — which is harder than learning — and that's how mastery shows up.",
          "case_challenge": "Managing Profitability"
        },
        {
          "id": "nick-apr1-bring-real-world",
          "facilitator": "Nick White",
          "session_label": "BD EMEA LEAPI · April 1, 2026",
          "timestamp": "00:11:55",
          "transcript_path": "Kickoff/Kickoff_Louis-04.01.26-Nick/GMT20260401-080436_Recording.transcript (2).vtt",
          "context": "Opening of the kickoff program",
          "quote": "We believe in bringing the real world in. So, we're gonna try and bring in as much of the real world as possible. Relate what we're learning back to BD. This is actually quite a challenging way of learning. It's actually a really powerful way of learning, because…",
          "why_magic": "Right at the start of the program, Nick sets the contract: the cases will feel uncomfortable because they're trying to mirror BD's real complexity, and that discomfort is the point. Participants who buy into that contract in minute 11 engage differently for the rest of the journey.",
          "case_challenge": "Kickoff: Shelf Awareness"
        }
