      "magic_moments": [
        {
          "id": "tam-may6-ai-reframe",
          "facilitator": "Tamara Nolte",
          "session_label": "BD AMS LEAPI Cohort 1 · May 6, 2026",
          "timestamp": "00:00:23",
          "transcript_path": "MP/MP-05.06.26-Tam/GMT20260506-150524_Recording.transcript.vtt",
          "context": "Opening framing of the case",
          "quote": "We are living in this world of AI. We can calculate break-even costs in a second on our computers. We could probably even build a really complex financial model in moments. So why even think about finance? Because it still needs human judgment — to understand the numbers, to understand why the decisions are being made, and to pressure test my assumptions.",
          "why_magic": "Tam names the elephant in the room before participants can. If AI can do the math, why are we here? She reframes the value proposition of the entire session in one breath, landing it on judgment and pressure-testing assumptions — which is exactly what the case will demand of them.",
          "case_challenge": "Managing Profitability"
        },
        {
          "id": "tam-may6-failure-is-the-goal",
          "facilitator": "Tamara Nolte",
          "session_label": "BD AMS LEAPI Cohort 1 · May 6, 2026",
          "timestamp": "00:09:48",
          "transcript_path": "MP/MP-05.06.26-Tam/GMT20260506-150524_Recording.transcript.vtt",
          "context": "Just before launching the first breakout",
          "quote": "Your job is to try things and make mistakes and see how you can figure it out. Failure actually is the goal here in order to learn and grow from it.",
          "why_magic": "She gives explicit permission to fail right before the first decision the teams have to make. Participants who feel safe taking risks engage more deeply — and the data later in the chapter (teams who tried bold paths got the best feedback) bears this out.",
          "case_challenge": "Managing Profitability"
        },
        {
          "id": "tam-may6-seeds-to-extrapolate",
          "facilitator": "Tamara Nolte",
          "session_label": "BD AMS LEAPI Cohort 1 · May 6, 2026",
          "timestamp": "00:43:39",
          "transcript_path": "MP/MP-05.06.26-Tam/GMT20260506-150524_Recording.transcript.vtt",
          "context": "Mid-debrief, bridging the simulation back to participants' real work",
          "quote": "Our time here is not well spent if we're not … like I've said in every session, our job is to provide seeds for you to extrapolate and pull back into your world.",
          "why_magic": "She makes the meta-purpose of the session explicit, mid-flow. The simulation isn't the point — the point is what participants can take back to BD. Naming that out loud reshapes how participants engage with the rest of the debrief.",
          "case_challenge": "Managing Profitability"
        }
      ],
